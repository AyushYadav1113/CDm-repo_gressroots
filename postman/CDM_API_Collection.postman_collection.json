    {
      "name": "2. Certificates",
      "description": "Endpoints to inspect SSL/TLS certificates discovered from ServiceNow CMDB and synchronized from Sectigo CA.",
      "item": [
        {
          "name": "Get Certificates (Paginated & Filtered)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response format is valid PagedResponse\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data.content).to.be.an(\"array\");",
                  "    pm.expect(jsonData.data.page).to.be.a(\"number\");",
                  "    pm.expect(jsonData.data.size).to.be.a(\"number\");",
                  "    pm.expect(jsonData.data.totalElements).to.be.a(\"number\");",
                  "    ",
                  "    if (jsonData.data.content.length > 0) {",
                  "        pm.environment.set(\"certificateId\", jsonData.data.content[0].id);",
                  "        console.log(\"Saved certificateId: \" + jsonData.data.content[0].id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/certificates?page=0&size=20&sortBy=createdAt&direction=DESC",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "certificates"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                },
                {
                  "key": "sortBy",
                  "value": "createdAt"
                },
                {
                  "key": "direction",
                  "value": "DESC"
                },
                {
                  "key": "status",
                  "value": "ACTIVE",
                  "disabled": true
                },
                {
                  "key": "source",
                  "value": "SERVICENOW",
                  "disabled": true
                },
                {
                  "key": "commonName",
                  "value": "api.example.com",
                  "disabled": true
                },
                {
                  "key": "issuer",
                  "value": "DigiCert",
                  "disabled": true
                }
              ]
            },
            "description": "Lists certificates with pagination, sorting (sortBy, direction), and multi-field filters (status, source, commonName, issuer)."
          },
          "response": []
        },
        {
          "name": "Get Certificate By ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK or 404\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data.id).to.eql(pm.environment.get(\"certificateId\"));",
                  "    pm.expect(jsonData.data.commonName).to.be.a(\"string\");",
                  "    pm.expect(jsonData.data.thumbprint).to.be.a(\"string\");",
                  "    pm.expect(jsonData.data).to.not.have.property(\"privateKey\");",
                  "    pm.expect(jsonData.data).to.not.have.property(\"secret\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/certificates/{{certificateId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "certificates",
                "{{certificateId}}"
              ]
            },
            "description": "Retrieves a single certificate by its UUID without exposing private keys or secrets."
          },
          "response": []
        }
      ]
