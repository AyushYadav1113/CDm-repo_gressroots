{
	"info": {
		"_postman_id": "9b1a5124-b13c-4d55-8947-8cfb62e49c91",
		"name": "Certificate Deployment Manager (CDM) API",
		"description": "Enterprise orchestration collection for Certificate Deployment Manager (CDM). Includes system diagnostics, Spring Boot Actuator probes, OpenAPI specifications, and security verification tests.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "System Diagnostics",
			"description": "Endpoints providing runtime diagnostics, component readiness, and PostgreSQL connectivity verification.",
			"item": [
				{
					"name": "Get System & Database Status",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has success flag true\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.eql(true);",
									"});",
									"",
									"pm.test(\"Database connectivity is UP\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.status).to.eql(\"HEALTHY\");",
									"    pm.expect(jsonData.data.components.database).to.include(\"UP\");",
									"});",
									"",
									"pm.test(\"Response time is under 1000ms\", function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(1000);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/system/status",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"system",
								"status"
							]
						},
						"description": "Retrieves real-time system diagnostic status, application version, and live PostgreSQL connection validation."
					},
					"response": []
				},
				{
					"name": "Ping (Liveness Check)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Ping returns pong\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.eql(true);",
									"    pm.expect(jsonData.data).to.eql(\"pong\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/system/ping",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"system",
								"ping"
							]
						},
						"description": "Lightweight ping endpoint for basic network and liveness availability checks."
					},
					"response": []
				}
			]
		},
		{
			"name": "Spring Boot Actuator",
			"description": "Production observability endpoints for liveness, readiness, and subsystem metrics.",
			"item": [
				{
					"name": "Actuator Health Check",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Overall Health Status is UP\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql(\"UP\");",
									"});",
									"",
									"pm.test(\"Database component is UP\", function () {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.components && jsonData.components.db) {",
									"        pm.expect(jsonData.components.db.status).to.eql(\"UP\");",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/actuator/health",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"actuator",
								"health"
							]
						},
						"description": "Spring Boot Actuator composite health probe verifying database connectivity, disk space, and application readiness."
					},
					"response": []
				},
