		{
			"name": "Security & Authorization Verification",
			"description": "Validation requests to ensure Spring Security properly enforces role-based access control and RFC-7807 error formats.",
			"item": [
				{
					"name": "Unauthenticated Access to Protected Endpoint (Expect 401)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 401 Unauthorized\", function () {",
									"    pm.response.to.have.status(401);",
									"});",
									"",
									"pm.test(\"Response conforms to RFC-7807 error format\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql(401);",
									"    pm.expect(jsonData.error).to.eql(\"Unauthorized\");",
									"    pm.expect(jsonData.path).to.eql(\"/api/v1/jobs\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/jobs",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"jobs"
							]
						},
						"description": "Negative security test verifying that requests without Basic Auth credentials to /api/v1/* are blocked with HTTP 401."
					},
					"response": []
				},
				{
					"name": "Authenticated Request with Basic Auth Credentials",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Request is authenticated and authorized\", function () {",
									"    pm.expect(pm.response.code).to.not.equal(401);",
									"    pm.expect(pm.response.code).to.not.equal(403);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "username",
									"value": "{{adminUsername}}",
									"type": "string"
								},
								{
									"key": "password",
									"value": "{{adminPassword}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/system/status",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"system",
								"status"
							]
						},
						"description": "Verifies authenticated access using {{adminUsername}} and {{adminPassword}}."
					},
					"response": []
				}
			]
		}
	],
