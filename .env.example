# ==============================================================================
# Certificate Deployment Manager (CDM) - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local overrides (never commit actual secrets).
# ==============================================================================

# Application Profile & Server
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
LOG_LEVEL_CDM=DEBUG

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cdm_db
DB_USERNAME=cdm_user
DB_PASSWORD=cdm_password_change_me
DB_SCHEMA=public

# Flyway Migration Settings
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true

# Spring Security / Internal System Credentials
SECURITY_BASIC_USERNAME=cdm_admin
SECURITY_BASIC_PASSWORD=admin_dev_password_change_me

# External Integration Placeholders (For Future Integration Phases)
# ServiceNow Integration
SERVICENOW_BASE_URL=https://example.service-now.com
SERVICENOW_INSTANCE_ID=instance_placeholder
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=

# Sectigo CA Integration
SECTIGO_BASE_URL=https://cert-manager.com/api/v1
SECTIGO_CUSTOMER_URI=
SECTIGO_LOGIN_NAME=
SECTIGO_PASSWORD=

# CyberArk CCP / AIM Integration
CYBERARK_CCP_URL=https://cyberark-aim.internal/AIMWebService/api/Accounts
CYBERARK_APP_ID=CDM_ORCHESTRATOR
CYBERARK_SAFE=CDM_PROD_SAFE

# MID Server Integration
SERVICENOW_MID_SERVER_NAME=MID_SERVER_PROD_01
